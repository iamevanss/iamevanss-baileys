{
  "name": "@iamvanss/baileys",
  "version": "0.1.0",
  "description": "STAIN Baileys - a custom, extensible WhatsApp Web library built from the Baileys ecosystem.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*",
    "WAProto/**/*",
    "engine-requirements.js"
  ],
  "keywords": [
    "whatsapp",
    "baileys",
    "whatsapp-web",
    "whatsapp-bot",
    "multi-device",
    "stain"
  ],
  "homepage": "https://github.com/iamevanss/iamevanss-baileys",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamevanss/iamevanss-baileys.git"
  },
  "bugs": {
    "url": "https://github.com/iamevanss/iamevanss-baileys/issues"
  },
  "license": "MIT",
  "author": "Evans (Vanss)",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:proto": "sh WAProto/GenerateStatics.sh",
    "dev": "tsx ./Example/example.ts",
    "lint": "tsc --noEmit && eslint src --ext .js,.ts",
    "test": "node --experimental-vm-modules ./node_modules/.bin/jest --testMatch '**/*.test.ts'",
    "prepack": "npm run build",
    "preinstall": "node ./engine-requirements.js"
  },
  "dependencies": {
    "@cacheable/node-cache": "^1.4.0",
    "@hapi/boom": "^9.1.3",
    "async-mutex": "^0.5.0",
    "cache-manager": "^7.2.8",
    "libsignal": "^6.0.0",
    "lru-cache": "^11.1.0",
    "music-metadata": "^11.12.3",
    "p-queue": "^9.0.0",
    "pino": "^9.6.0",
    "protobufjs": "^7.5.6",
    "whatsapp-rust-bridge": "^0.5.4",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "jimp": "^1.6.1",
    "link-preview-js": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "jimp": {
      "optional": true
    },
    "link-preview-js": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
